branch="$(git branch --show-current)" || exit $?
staged="$(git diff --cached --name-only --no-renames)" || exit $?
if [ "$branch" = "tracker/state" ] && [ "$staged" = ".beads/issues.jsonl" ]; then
	exec bun run scripts/beads-validate.ts
fi

bunx lint-staged || exit $?
git diff --cached --check || exit $?
bun run typecheck || exit $?
