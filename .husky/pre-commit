# beeswax:begin tracker-validation v2
"$(git rev-parse --git-path beeswax/cli)" system hooks validate || exit $?
# beeswax:end tracker-validation

# Hive application policy: tracker snapshots do not run code checks.
if "$(git rev-parse --git-path beeswax/cli)" system hooks is-tracker-snapshot; then exit 0; fi
bunx lint-staged || exit $?
git diff --cached --check || exit $?
bun run typecheck || exit $?
