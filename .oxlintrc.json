{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"pedantic": "error",
		"perf": "error",
		"style": "error",
		"restriction": "off",
		"nursery": "off"
	},
	"plugins": ["eslint", "typescript", "oxc", "unicorn", "import", "promise", "node"],
	"env": {
		"es2026": true,
		"node": true
	},
	"globals": {
		"Bun": "readonly"
	},
	"rules": {
		"func-style": ["error", "declaration", { "allowArrowFunctions": true }],
		"import/exports-last": "off",
		"import/group-exports": "off",
		"import/no-named-export": "off",
		"import/prefer-default-export": "off",
		"max-lines": "off",
		"max-lines-per-function": "off",
		"one-var": "off",
		"unicorn/consistent-function-scoping": "off",
		"no-duplicate-imports": ["error", { "allowSeparateTypeImports": true }]
	},
	"overrides": [
		{
			"files": ["lib/shared/**/*.{ts,tsx}"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "^@hive/(colony|ghost|honeycomb|tooling|waggle)(/|$)|(^|\\.\\./)(colony|ghost|honeycomb|tooling|waggle)(/|$)|(^|/)lib/(colony|ghost|honeycomb|tooling|waggle)(/|$)",
								"message": "shared sits at the base of the dependency graph and must not import colony, ghost, honeycomb, tooling, or waggle."
							}
						]
					}
				]
			}
		},
		{
			"files": ["lib/colony/**/*.{ts,tsx}"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "^@hive/(colony|ghost|honeycomb|tooling|waggle)(/|$)|(^|\\.\\./)(colony|ghost|honeycomb|shared|tooling|waggle)(/|$)|(^|/)lib/(colony|ghost|honeycomb|shared|tooling|waggle)(/|$)",
								"message": "packages may only import from @hive/shared via the package specifier; relative cross-package imports are forbidden."
							}
						]
					}
				]
			}
		},
		{
			"files": ["lib/ghost/**/*.{ts,tsx}"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "^@hive/(colony|ghost|honeycomb|tooling|waggle)(/|$)|(^|\\.\\./)(colony|ghost|honeycomb|shared|tooling|waggle)(/|$)|(^|/)lib/(colony|ghost|honeycomb|shared|tooling|waggle)(/|$)",
								"message": "packages may only import from @hive/shared via the package specifier; relative cross-package imports are forbidden."
							}
						]
					}
				]
			}
		},
		{
			"files": ["lib/honeycomb/**/*.{ts,tsx}"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "^@hive/(colony|ghost|honeycomb|tooling|waggle)(/|$)|(^|\\.\\./)(colony|ghost|shared|honeycomb|tooling|waggle)(/|$)|(^|/)lib/(colony|ghost|shared|honeycomb|tooling|waggle)(/|$)",
								"message": "packages may only import from @hive/shared via the package specifier; relative cross-package imports are forbidden."
							}
						]
					}
				]
			}
		},
		{
			"files": ["lib/tooling/**/*.{ts,tsx}"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "^@hive/(colony|ghost|honeycomb|tooling|waggle)(/|$)|(^|\\.\\./)(colony|ghost|shared|honeycomb|tooling|waggle)(/|$)|(^|/)lib/(colony|ghost|shared|honeycomb|tooling|waggle)(/|$)",
								"message": "packages may only import from @hive/shared via the package specifier; relative cross-package imports are forbidden."
							}
						]
					}
				]
			}
		},
		{
			"files": ["lib/waggle/**/*.{ts,tsx}"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "^@hive/(colony|ghost|honeycomb|tooling|waggle)(/|$)|(^|\\.\\./)(colony|ghost|shared|honeycomb|tooling|waggle)(/|$)|(^|/)lib/(colony|ghost|shared|honeycomb|tooling|waggle)(/|$)",
								"message": "packages may only import from @hive/shared via the package specifier; relative cross-package imports are forbidden."
							}
						]
					}
				]
			}
		}
	]
}
