{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"pedantic": "error",
		"perf": "error",
		"style": "error",
		"restriction": "off",
		"nursery": "off"
	},
	"plugins": ["eslint", "typescript", "oxc", "unicorn", "import", "promise", "node"],
	"env": {
		"es2026": true,
		"node": true
	},
	"globals": {
		"Bun": "readonly"
	},
	"rules": {
		"import/group-exports": "off",
		"import/no-named-export": "off",
		"import/prefer-default-export": "off",
		"one-var": "off"
	},
	"overrides": [
		{
			"files": ["lib/shared/**/*.{ts,tsx}"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "^@hive/(colony|ghost|honeycomb|tooling)(/|$)|(^|\\.\\./)(colony|ghost|honeycomb|tooling)(/|$)|(^|/)lib/(colony|ghost|honeycomb|tooling)(/|$)",
								"message": "shared sits at the base of the dependency graph and must not import colony, ghost, honeycomb, or tooling."
							}
						]
					}
				]
			}
		},
		{
			"files": ["lib/colony/**/*.{ts,tsx}"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "^@hive/(colony|ghost|honeycomb|tooling)(/|$)|(^|\\.\\./)(colony|ghost|honeycomb|shared|tooling)(/|$)|(^|/)lib/(colony|ghost|honeycomb|shared|tooling)(/|$)",
								"message": "packages may only import from @hive/shared via the package specifier; relative cross-package imports are forbidden."
							}
						]
					}
				]
			}
		},
		{
			"files": ["lib/ghost/**/*.{ts,tsx}"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "^@hive/(colony|ghost|honeycomb|tooling)(/|$)|(^|\\.\\./)(colony|ghost|honeycomb|shared|tooling)(/|$)|(^|/)lib/(colony|ghost|honeycomb|shared|tooling)(/|$)",
								"message": "packages may only import from @hive/shared via the package specifier; relative cross-package imports are forbidden."
							}
						]
					}
				]
			}
		},
		{
			"files": ["lib/honeycomb/**/*.{ts,tsx}"],
			"rules": {
				"capitalized-comments": "off",
				"curly": "off",
				"func-style": "off",
				"id-length": "off",
				"import/consistent-type-specifier-style": "off",
				"import/exports-last": "off",
				"import/first": "off",
				"import/newline-after-import": "off",
				"import/no-nodejs-modules": "off",
				"init-declarations": "off",
				"max-classes-per-file": "off",
				"max-lines": "off",
				"max-lines-per-function": "off",
				"max-params": "off",
				"max-statements": "off",
				"no-await-in-loop": "off",
				"no-continue": "off",
				"no-magic-numbers": "off",
				"no-negated-condition": "off",
				"no-nested-ternary": "off",
				"no-shadow": "off",
				"no-ternary": "off",
				"no-useless-return": "off",
				"node/no-sync": "off",
				"prefer-destructuring": "off",
				"prefer-named-capture-group": "off",
				"promise/avoid-new": "off",
				"promise/param-names": "off",
				"require-await": "off",
				"require-unicode-regexp": "off",
				"sort-imports": "off",
				"sort-keys": "off",
				"typescript/array-type": "off",
				"typescript/consistent-type-definitions": "off",
				"typescript/method-signature-style": "off",
				"unicorn/custom-error-definition": "off",
				"unicorn/escape-case": "off",
				"unicorn/no-array-callback-reference": "off",
				"unicorn/no-array-sort": "off",
				"unicorn/no-await-expression-member": "off",
				"unicorn/no-hex-escape": "off",
				"unicorn/no-negated-condition": "off",
				"unicorn/no-nested-ternary": "off",
				"unicorn/no-null": "off",
				"unicorn/no-useless-undefined": "off",
				"unicorn/numeric-separators-style": "off",
				"unicorn/prefer-native-coercion-functions": "off",
				"unicorn/prefer-string-raw": "off",
				"unicorn/prefer-string-replace-all": "off",
				"unicorn/prefer-ternary": "off",
				"unicorn/switch-case-braces": "off",
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "^@hive/(colony|ghost|honeycomb|tooling)(/|$)|(^|\\.\\./)(colony|ghost|shared|honeycomb|tooling)(/|$)|(^|/)lib/(colony|ghost|shared|honeycomb|tooling)(/|$)",
								"message": "packages may only import from @hive/shared via the package specifier; relative cross-package imports are forbidden."
							}
						]
					}
				]
			}
		},
		{
			"files": ["lib/tooling/**/*.{ts,tsx}"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "^@hive/(colony|ghost|honeycomb|tooling)(/|$)|(^|\\.\\./)(colony|ghost|shared|honeycomb|tooling)(/|$)|(^|/)lib/(colony|ghost|shared|honeycomb|tooling)(/|$)",
								"message": "packages may only import from @hive/shared via the package specifier; relative cross-package imports are forbidden."
							}
						]
					}
				]
			}
		},
		{
			"files": [
				"scripts/beads-jsonl.ts",
				"scripts/beads-merge-core.ts",
				"scripts/beads-merge.test.ts"
			],
			"rules": {
				"func-style": [
					"error",
					"declaration",
					{
						"allowArrowFunctions": true
					}
				],
				"import/exports-last": "off",
				"max-lines": "off",
				"sort-keys": "off"
			}
		}
	]
}
