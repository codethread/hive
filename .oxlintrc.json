{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"pedantic": "error",
		"perf": "error",
		"style": "error",
		"restriction": "off",
		"nursery": "off"
	},
	"plugins": ["eslint", "typescript", "oxc", "unicorn", "import", "promise", "node"],
	"env": {
		"es2026": true,
		"node": true
	},
	"globals": {
		"Bun": "readonly"
	},
	"rules": {
		"func-style": ["error", "declaration", { "allowArrowFunctions": true }],
		"import/exports-last": "off",
		"import/group-exports": "off",
		"import/no-named-export": "off",
		"import/prefer-default-export": "off",
		"max-lines": "off",
		"max-lines-per-function": "off",
		"one-var": "off",
		"unicorn/consistent-function-scoping": "off",
		"no-duplicate-imports": ["error", { "allowSeparateTypeImports": true }]
	},
	"overrides": [
		{
			"files": ["lib/shared/**/*.{ts,tsx}"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "^@hive/(colony|honeycomb|tooling|waggle|hive-ui)(/|$)|(^|\\.\\./)(colony|honeycomb|tooling|waggle|hive-ui)(/|$)|(^|/)lib/(colony|honeycomb|tooling|waggle|hive-ui)(/|$)",
								"message": "shared sits at the base of the dependency graph and must not import colony, honeycomb, tooling, waggle, or hive-ui."
							}
						]
					}
				]
			}
		},
		{
			"files": ["lib/colony/**/*.{ts,tsx}"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "^@hive/(colony|honeycomb|tooling|waggle|hive-ui)(/|$)|(^|\\.\\./)(colony|honeycomb|shared|tooling|waggle|hive-ui)(/|$)|(^|/)lib/(colony|honeycomb|shared|tooling|waggle|hive-ui)(/|$)",
								"message": "packages may only import from @hive/shared via the package specifier; relative cross-package imports are forbidden."
							}
						]
					}
				]
			}
		},
		{
			"files": ["lib/honeycomb/**/*.{ts,tsx}"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "^@hive/(colony|honeycomb|tooling|waggle|hive-ui)(/|$)|(^|\\.\\./)(colony|shared|honeycomb|tooling|waggle|hive-ui)(/|$)|(^|/)lib/(colony|shared|honeycomb|tooling|waggle|hive-ui)(/|$)",
								"message": "packages may only import from @hive/shared via the package specifier; relative cross-package imports are forbidden."
							}
						]
					}
				]
			}
		},
		{
			"files": ["lib/tooling/**/*.{ts,tsx}"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "^@hive/(colony|honeycomb|tooling|waggle|hive-ui)(/|$)|(^|\\.\\./)(colony|shared|honeycomb|tooling|waggle|hive-ui)(/|$)|(^|/)lib/(colony|shared|honeycomb|tooling|waggle|hive-ui)(/|$)",
								"message": "packages may only import from @hive/shared via the package specifier; relative cross-package imports are forbidden."
							}
						]
					}
				]
			}
		},
		{
			"files": ["lib/waggle/**/*.{ts,tsx}"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "^@hive/(colony|honeycomb|tooling|waggle|hive-ui)(/|$)|(^|\\.\\./)(colony|shared|honeycomb|tooling|waggle|hive-ui)(/|$)|(^|/)lib/(colony|shared|honeycomb|tooling|waggle|hive-ui)(/|$)",
								"message": "packages may only import from @hive/shared via the package specifier; relative cross-package imports are forbidden."
							}
						]
					}
				]
			}
		},
		{
			"files": ["lib/hive-ui/**/*.{ts,tsx}"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "^@hive/(colony|honeycomb|tooling|waggle|hive-ui)(/|$)|(^|\\.\\./)(colony|shared|honeycomb|tooling|waggle|hive-ui)(/|$)|(^|/)lib/(colony|shared|honeycomb|tooling|waggle|hive-ui)(/|$)",
								"message": "packages may only import from @hive/shared via the package specifier; relative cross-package imports are forbidden."
							}
						]
					}
				],
				"react/react-in-jsx-scope": "off",
				"react/rules-of-hooks": "error",
				"react/exhaustive-deps": "error",
				"unicorn/no-null": "off",
				"no-magic-numbers": [
					"error",
					{
						"ignore": [0, 1]
					}
				],
				"react/jsx-max-depth": [
					"error",
					{
						"max": 8
					}
				],
				"typescript/prefer-readonly-parameter-types": "off",
				"typescript/dot-notation": [
					"error",
					{
						"allowIndexSignaturePropertyAccess": true
					}
				]
			},
			"plugins": ["react", "jsx-a11y"]
		},
		{
			"files": ["lib/hive-ui/src/**/*.{ts,tsx}"],
			"env": {
				"browser": true
			},
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "^@hive/|(^|/)server/|^bun:|^node:|(^|\\.\\./)(colony|shared|honeycomb|tooling|waggle|hive-ui)(/|$)|(^|/)lib/(colony|shared|honeycomb|tooling|waggle|hive-ui)(/|$)",
								"message": "Browser code uses the HTTP contracts; server/native code stays behind the API."
							}
						]
					}
				],
				"no-ternary": "off"
			}
		}
	]
}
