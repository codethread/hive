				"hooks": [
					{
						"type": "command",
						"command": "bun \"${PLUGIN_ROOT}/dist/codex.js\""
					}
				]
			}
		],
		"SubagentStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun \"${PLUGIN_ROOT}/dist/codex.js\""
					}
				]
			}
		]
	}
}
