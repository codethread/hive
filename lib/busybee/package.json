{
	"name": "@hive/busybee",
	"version": "0.8.0",
	"private": true,
	"bin": {
		"busybee": "./bin/busybee.ts"
	},
	"type": "module",
	"exports": "./src/runtime.ts",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"build": "bun build ./bin/busybee.ts --compile --target=${HIVE_BUILD_TARGET:-bun} --compile-autoload-package-json --compile-autoload-tsconfig --outfile ./dist/busybee",
