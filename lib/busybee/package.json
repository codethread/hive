	},
	"dependencies": {
		"@hive/beads": "workspace:*",
		"@hive/shared": "workspace:*",
		"commander": "^15.0.0",
		"gray-matter": "^4.0.3",
		"semver": "^7.8.5",
		"skills-handler": "^0.1.2",
		"xstate": "^5.33.2",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/semver": "^7.8.0"
	}
}
