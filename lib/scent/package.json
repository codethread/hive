{
	"name": "@hive/scent",
	"version": "0.9.1",
	"private": true,
	"bin": {
		"scent": "./src/bin/scent.ts"
	},
	"type": "module",
	"scripts": {
		"build": "bun build ./src/bin/scent.ts --compile --target=${HIVE_BUILD_TARGET:-bun} --outfile ./dist/scent",
		"install:bin": "beeswax artifacts install scent",
		"typecheck": "tsc --noEmit",
		"test": "bun test ./tests"
	},
	"dependencies": {
		"@hive/shared": "workspace:*",
		"commander": "^14.0.3",
		"unique-names-generator": "4.7.1",
		"zod": "^4.6.5"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "1.2.0"
	},
	"pi": {
		"extensions": [
			"./src/bin/pi.ts"
		]
	}
}
