{
	"name": "@hive/hive-ui",
	"version": "0.5.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --hot ./server/index.ts",
		"start": "bun ./server/index.ts",
		"typecheck": "tsc --noEmit && bun run storybook:check",
		"build": "bun run ./scripts/build.ts",
		"storybook": "storybook dev --host 0.0.0.0 --port 6006 --disable-telemetry",
		"storybook:build": "storybook build --output-dir dist/storybook --disable-telemetry",
		"install:bin": "bun run ../tooling/src/install-artifacts.ts hive-ui",
		"storybook:check": "bun ./scripts/check-story-catalogue.ts"
	},
	"dependencies": {
		"@dagrejs/dagre": "^3.1.1",
		"@hive/beads": "workspace:*",
		"@hive/shared": "workspace:*",
		"@radix-ui/react-context-menu": "^2.3.8",
		"@radix-ui/react-dialog": "^1.3.0",
		"@radix-ui/react-dropdown-menu": "^2.1.25",
		"@radix-ui/react-slot": "^1.5.0",
		"@radix-ui/react-tabs": "^1.2.0",
		"@tanstack/react-router": "^1.170.35",
		"@xyflow/react": "^12.12.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"commander": "^15.0.0",
		"lucide-react": "^1.56.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"zod": "^4.6.5",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@storybook/addon-a11y": "^10.6.2",
		"@storybook/addon-docs": "^10.6.2",
		"@storybook/react-vite": "^10.6.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"bun-plugin-tailwind": "^0.1.2",
		"msw": "^3.0.3",
		"msw-storybook-addon": "^3.0.3",
		"storybook": "^10.6.2",
		"vite": "^8.3.4"
	},
	"msw": {
		"workerDirectory": [
			".storybook/public"
		]
	}
}
