		"@xyflow/react": "^12.12.0",
		"commander": "^15.0.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"tailwindcss": "^4.3.3",
		"zod": "^4.6.5",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
