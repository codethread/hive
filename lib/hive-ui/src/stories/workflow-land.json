{
	"id": "land",
	"initial": "check",
	"states": {
		"check": {
			"id": "land.check",
			"type": "atomic",
			"on": {
				"PASSED": [
					{
						"target": ["#land.librarian"]
					}
				],
				"INTEGRATED": [
					{
						"target": ["#land.librarian"]
					}
				],
				"TIMING": [
					{
						"target": ["#land.librarian"]
					}
				],
				"BLOCKED": [
					{
						"target": ["#land.preserve-draft"]
					}
				],
				"DEFERRED": [
					{
						"target": ["#land.merged-blocked"]
					}
				]
			}
		},
		"librarian": {
			"id": "land.librarian",
			"type": "atomic",
			"on": {
				"APPROVED": [
					{
						"target": ["#land.review"]
					}
				],
				"CHANGES": [
					{
						"target": ["#land.check"]
					}
				]
			}
		},
		"review": {
			"id": "land.review",
			"type": "atomic",
			"on": {
				"APPROVED": [
					{
						"target": ["#land.verify"],
						"guard": "alreadyIntegrated"
					},
					{
						"target": ["#land.reviewed-draft"],
						"guard": "timingException"
					},
					{
						"target": ["#land.finish"]
					}
				],
				"CHANGES": [
					{
						"target": ["#land.check"]
					}
				]
			}
		},
		"finish": {
			"id": "land.finish",
			"type": "atomic",
			"on": {
				"NEXT": [
					{
						"target": ["#land.verify"]
					}
				],
				"BLOCKED": [
					{
						"target": ["#land.reviewed-draft"]
					}
				],
				"CHANGES": [
					{
						"target": ["#land.check"]
					}
				]
			}
		},
		"verify": {
			"id": "land.verify",
			"type": "atomic",
			"on": {
				"NEXT": [
					{
						"target": ["#land.local-update"]
					}
				],
				"DEFERRED": [
					{
						"target": ["#land.merged-blocked"]
					}
				],
				"CHANGES": [
					{
						"target": ["#land.check"]
					}
				]
			}
		},
		"local-update": {
			"id": "land.local-update",
			"type": "atomic",
			"on": {
				"NEXT": [
					{
						"target": ["#land.done"]
					}
				],
				"DEFERRED": [
					{
						"target": ["#land.merged-blocked"]
					}
				]
			}
		},
		"reviewed-draft": {
			"id": "land.reviewed-draft",
			"type": "atomic",
			"on": {
				"PUBLISHED": [
					{
						"target": ["#land.draft-delivered"]
					}
				],
				"CHANGES": [
					{
						"target": ["#land.check"]
					}
				]
			}
		},
		"preserve-draft": {
			"id": "land.preserve-draft",
			"type": "atomic",
			"on": {
				"PUBLISHED": [
					{
						"target": ["#land.draft-delivered"]
					}
				]
			}
		},
		"draft-delivered": {
			"id": "land.draft-delivered",
			"type": "final",
			"on": {}
		},
		"merged-blocked": {
			"id": "land.merged-blocked",
			"type": "final",
			"on": {}
		},
		"done": {
			"id": "land.done",
			"type": "final",
			"on": {}
		}
	}
}
