{
	"id": "land",
	"initial": "check",
	"states": {
		"check": {
			"id": "land.check",
			"type": "atomic",
			"on": {
				"PASSED": [
					{
						"target": ["#land.librarian"]
					}
				],
				"INTEGRATED": [
					{
						"target": ["#land.librarian"]
					}
				]
			}
		},
		"librarian": {
			"id": "land.librarian",
			"type": "atomic",
			"on": {
				"APPROVED": [
					{
						"target": ["#land.review"]
					}
				],
				"CHANGES": [
					{
						"target": ["#land.check"]
					}
				]
			}
		},
		"review": {
			"id": "land.review",
			"type": "atomic",
			"on": {
				"APPROVED": [
					{
						"target": ["#land.verify"],
						"guard": "alreadyIntegrated"
					},
					{
						"target": ["#land.finish"]
					}
				],
				"CHANGES": [
					{
						"target": ["#land.check"]
					}
				]
			}
		},
		"finish": {
			"id": "land.finish",
			"type": "atomic",
			"on": {
				"NEXT": [
					{
						"target": ["#land.verify"]
					}
				],
				"CHANGES": [
					{
						"target": ["#land.check"]
					}
				]
			}
		},
		"verify": {
			"id": "land.verify",
			"type": "atomic",
			"on": {
				"NEXT": [
					{
						"target": ["#land.local-update"]
					}
				],
				"CHANGES": [
					{
						"target": ["#land.check"]
					}
				]
			}
		},
		"local-update": {
			"id": "land.local-update",
			"type": "atomic",
			"on": {
				"NEXT": [
					{
						"target": ["#land.done"]
					}
				]
			}
		},
		"done": {
			"id": "land.done",
			"type": "final",
			"on": {}
		}
	}
}
