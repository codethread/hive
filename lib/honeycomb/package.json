{
	"name": "@hive/honeycomb",
	"version": "0.6.0",
	"private": true,
	"bin": {
		"honeycomb": "./bin/honeycomb.ts"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"test": "bun test --parallel --parallel-delay=0 --timeout=5000 --only-failures ./tests",
		"typecheck": "tsc --noEmit && bun run schema:check",
		"schema:generate": "bun run ./scripts/config-schema.ts",
		"schema:stage": "bun run schema:generate && git add -- honeycomb.schema.json honeycomb.local.schema.json",
		"schema:check": "bun run ./scripts/config-schema.ts --check",
		"build": "bun build ./bin/honeycomb.ts --compile --target=${HIVE_BUILD_TARGET:-bun} --outfile ./dist/honeycomb",
		"test:unit": "bun test --parallel --parallel-delay=0 --timeout=5000 --only-failures ./tests/unit",
		"test:integration": "bun test --parallel --parallel-delay=0 --timeout=5000 --only-failures ./tests/integration",
		"install:bin": "beeswax artifacts install honeycomb"
	},
	"dependencies": {
		"@bomb.sh/tab": "0.0.22",
		"@hive/shared": "workspace:*",
		"commander": "^14.0.3",
		"gray-matter": "^4.0.3",
		"skills-handler": "^0.1.2",
		"zod": "^4.4.3"
	}
}
