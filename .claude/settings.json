{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "beeswax system beads session-start"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "beeswax prime",
						"statusMessage": "Beeswax onboarding v1"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "beeswax system harness-alert --harness claude",
						"statusMessage": "Beeswax tracker alerts v1"
					}
				]
			},
			{
				"matcher": "^(startup|resume|clear|compact)$",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$CLAUDE_PROJECT_DIR/lib/scent/src/bin/claude.ts\""
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "beeswax system harness-alert --harness claude",
						"statusMessage": "Beeswax tracker alerts v1"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "beeswax system harness-alert --harness claude",
						"statusMessage": "Beeswax tracker alerts v1"
					}
				]
			}
		],
		"SubagentStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$CLAUDE_PROJECT_DIR/lib/scent/src/bin/claude.ts\""
					}
				]
			}
		]
	}
}
