{
	"name": "hive",
	"version": "0.8.0",
	"private": true,
	"keywords": [
		"pi-package"
	],
	"workspaces": [
		"lib/*"
	],
	"type": "module",
	"scripts": {
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint --deny-warnings && oxlint --type-aware --deny-warnings lib/hive-ui",
		"lint:fix": "oxlint --fix",
		"typecheck": "tsc --noEmit -p tsconfig.json && bun run --filter '*' typecheck",
		"test:all": "bun run ./lib/tooling/src/test-runner.ts all",
		"test:changed": "bun run ./lib/tooling/src/test-runner.ts changed",
		"test:contracts": "bun run ./lib/tooling/src/test-runner.ts contracts",
		"check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test:all",
		"beads:bootstrap": "beeswax beads bootstrap --environment mise",
		"beads:setup": "beeswax beads setup",
		"beads:env": "beeswax beads env",
		"beads:sync": "beeswax beads sync",
		"prepare": "beeswax system prepare",
		"waggle": "bun run ./lib/waggle/bin/waggle.ts",
		"busybee": "bun run ./lib/busybee/bin/busybee.ts",
		"release": "bun run ./lib/tooling/src/release-cli.ts",
		"beeswax": "bun run ./lib/beeswax/bin/beeswax.ts"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@earendil-works/pi-coding-agent": "1.2.0",
		"@hive/beeswax": "workspace:*",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/bun": "^1.4.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"oxlint-tsgolint": "^7.0.2001",
		"typescript": "^7.0.2",
		"xstate": "^5.33.2",
		"zod": "^4.6.5"
	},
	"lint-staged": {
		"lib/honeycomb/{src/schemas.ts,scripts/config-schema.ts}": "bun run --filter @hive/honeycomb schema:stage",
		"!(mockServiceWorker).{js,jsx,ts,tsx,mjs,cjs}": [
			"oxlint --fix",
			"oxfmt --no-error-on-unmatched-pattern"
		],
		"!(*.jsonl|mockServiceWorker.js)": "oxfmt --no-error-on-unmatched-pattern"
	},
	"pi": {
		"skills": [
			"./plugins/honeycomb/skills"
		]
	}
}
