{
	"name": "hive",
	"private": true,
	"workspaces": [
		"lib/*"
	],
	"type": "module",
	"scripts": {
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint --deny-warnings",
		"lint:fix": "oxlint --fix",
		"typecheck": "bun run --filter '*' typecheck",
		"check": "bun run fmt:check && bun run lint && bun run typecheck"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"typescript": "^7.0.2"
	}
}
