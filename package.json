{
	"name": "hive",
	"private": true,
	"workspaces": [
		"lib/*"
	],
	"type": "module",
	"scripts": {
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint --deny-warnings",
		"lint:fix": "oxlint --fix",
		"typecheck": "tsc --noEmit -p tsconfig.json && bun run --filter '*' typecheck",
		"test": "bun test --parallel --parallel-delay=0 --timeout=5000 --only-failures",
		"test:changed": "bun run test --changed",
		"check": "bun run fmt:check && bun run lint && bun run typecheck",
		"git:setup": "bun run ./scripts/setup-git.ts",
		"agents:sync": "bun run --filter @hive/tooling agents:sync",
		"prepare": "husky && bun run git:setup && sh .husky/beads-sync"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@types/bun": "^1.4.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"typescript": "^7.0.2"
	},
	"lint-staged": {
		"lib/honeycomb/{src/schemas.ts,scripts/config-schema.ts}": "bun run --filter @hive/honeycomb schema:stage",
		"*.{js,jsx,ts,tsx,mjs,cjs}": [
			"oxlint --fix",
			"oxfmt"
		],
		"*": "oxfmt --no-error-on-unmatched-pattern"
	}
}
